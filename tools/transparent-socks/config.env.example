# Upstream proxy settings
PROXY_TYPE="socks5"
PROXY_HOST="203.0.113.10"
PROXY_PORT="1080"
PROXY_USER=""
PROXY_PASS=""

# Local redsocks listener
REDSOCKS_LOCAL_IP="127.0.0.1"
REDSOCKS_LOCAL_PORT="18086"

# Name of the NAT chain to create
CHAIN_NAME="REDSOCKS"

# Optional UID whose traffic should bypass redirect
# Example: BYPASS_UID="1000"
BYPASS_UID=""

# Space-separated additional destination CIDRs to bypass
EXTRA_BYPASS_CIDRS=""

# Space-separated destination ports to bypass
# Keep 22 by default to help avoid accidental SSH lockout
EXTRA_BYPASS_PORTS="22"

# Generated/configured file locations
REDSOCKS_CONF="/etc/redsocks.conf"
SYSTEMD_UNIT_DEST="/etc/systemd/system/redsocks-transparent.service"
IPTABLES_SAVE_FILE="/etc/iptables/rules.v4"
